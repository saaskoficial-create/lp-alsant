---
import { testimonials } from '@/content/landing';
const approved = testimonials.filter((t) => t.approved).slice(0, 3);
---

{approved.length >= 2 && (
  <section class="section container" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">Quem conhece a Biosenz entende a diferença.</h2>
    <div class="testimonials">
      {approved.map((t) => (
        <figure>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <img src={t.photo} alt="" width="64" height="64" loading="lazy" />
            <strong>{t.name}</strong>
            <span>
              {t.specialty} — {t.clinic}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
